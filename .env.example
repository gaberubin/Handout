# ─────────────────────────────────────────────
# HANDOUT — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────

# ── SUPABASE ─────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── SITE URL ─────────────────────────────────
# Local development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (update when you deploy)
# NEXT_PUBLIC_SITE_URL=https://handout.app

# ── STRIPE (for payments - optional for now) ─
# Get from: stripe.com → Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create in Stripe dashboard)
STRIPE_PLUS_PRICE_ID=price_your_plus_plan_id
STRIPE_PRO_PRICE_ID=price_your_pro_plan_id
